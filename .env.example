# Groq Cloud API Key — obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (Strictly: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Reasoning Effort (Strictly: low)
GROQ_REASONING_EFFORT=low

# Redis Connection URL for Distributed BullMQ Queue (Optional for local dev, Required for production multi-instance)
# e.g., Upstash Redis, Redis Cloud, or local redis://localhost:6379
# If omitted in local dev, an automatic robust in-memory FIFO queue with the same 15s cooldown runs seamlessly.
REDIS_URL=redis://default:password@your-redis-host:6379

# Minimum post-completion cooldown between Groq API requests in milliseconds (Default: 15000)
GROQ_MIN_INTERVAL_MS=15000
